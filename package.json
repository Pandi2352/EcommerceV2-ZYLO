{
  "name": "zylo",
  "version": "1.0.0",
  "private": true,
  "description": "ZYLO \u2014 Modern E-Commerce Platform Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:storefront": "npm run dev -w @zylo/storefront",
    "dev:admin": "npm run dev -w @zylo/admin",
    "dev:server": "npm run start:dev --prefix server",
    "build:storefront": "npm run build -w @zylo/storefront",
    "build:admin": "npm run build -w @zylo/admin",
    "build:web": "npm run build -w @zylo/storefront -w @zylo/admin",
    "build:server": "npm run build --prefix server",
    "lint:web": "npm run lint -w @zylo/shared -w @zylo/storefront -w @zylo/admin",
    "seed": "node seeds/index.js",
    "sync:versions": "node -e \"require('./server/node_modules/ts-node').register(); require('./version-control.ts').runVersionControl();\"",
    "sync:check": "node -e \"require('./server/node_modules/ts-node').register(); require('./version-control.ts').runVersionControl({ skipInstall: true });\""
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~6.0.2"
  }
}
