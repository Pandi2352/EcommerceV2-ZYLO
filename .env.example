# ==========================================
# ZYLO Environment Configuration Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String
# Local (MongoDB Compass): mongodb://127.0.0.1:27017/zylo
# Docker Container: mongodb://mongodb:27017/zylo
# Production / MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/zylo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/zylo

# Security & JWT Tokens
JWT_ACCESS_SECRET=zylo_super_secret_access_jwt_key_2026_dev
JWT_REFRESH_SECRET=zylo_super_secret_refresh_jwt_key_2026_dev
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Uploads
UPLOAD_DIR=./uploads

# Payment Gateways (Test Mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
