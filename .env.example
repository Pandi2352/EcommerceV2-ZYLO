# ==========================================
# ZYLO Environment Configuration Template
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB Connection String
# Local (MongoDB Compass): mongodb://127.0.0.1:27017/zylo
# Docker Container: mongodb://mongodb:27017/zylo
# Production / MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/zylo?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/zylo

# Security & JWT Tokens (REQUIRED — the server will not start without both secrets)
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
# Durations: number + s|m|h|d
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_REMEMBER_EXPIRY=30d

# Key for encrypting secrets at rest, e.g. two-factor (TOTP) secrets. REQUIRED, min 32 chars.
# Changing it makes existing two-factor setups unusable.
ENCRYPTION_KEY=replace_with_another_long_random_secret_min_32_chars

# App origins (comma-separated lists are accepted). Used for CORS and for links in emails:
# customers are sent to CLIENT_URL (storefront), staff to ADMIN_URL (admin console).
# These are the single source of truth for app origins: the API's CORS allowlist and email links,
# and the Vite dev servers' host + port (see packages/shared/vite.base.ts) all derive from them.
# In development the admin runs on 127.0.0.1 so its cookies stay separate from the storefront's.
CLIENT_URL=http://localhost:5176
ADMIN_URL=http://127.0.0.1:5175

# Shop prefix for auto-generated staff User IDs (2–5 letters): ZY → ZY-0001, ZY-0002, …
USER_CODE_PREFIX=ZY

# Reverse proxy hops to trust for client IPs (set to 1 behind nginx; empty for direct access)
TRUST_PROXY=

# Seed script passwords (npm run seed). Dev defaults are used when empty; required in production.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_SUPPORT_PASSWORD=

# Email (SMTP). Leave SMTP_HOST empty in development: emails are printed to the server log.
APP_NAME=ZYLO
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ZYLO <no-reply@zylo.local>"

# Google sign-in (optional). Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must equal GOOGLE_CALLBACK_URL. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5176/api/v1/auth/google/callback

# Uploads
UPLOAD_DIR=./uploads

# Payment Gateways (Test Mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
