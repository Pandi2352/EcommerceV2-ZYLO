# ==========================================
# ZYLO - Monorepo .gitignore
# ==========================================

# 1. Dependencies & Package Managers
node_modules/
apps/*/node_modules/
packages/*/node_modules/
server/node_modules/
.pnp
.pnp.js
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnpm-store/

# 2. Build Outputs & Compilations
dist/
dist-ssr/
build/
apps/*/dist/
server/dist/
*.tsbuildinfo
server/tsconfig.build.tsbuildinfo

# 3. Environment Variables & Secrets (Keep .env.example safe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.env.vault
*.pem
*.key
*.cert
*.crt

# 4. Runtime Volumes & Local Storage
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep
pgdata/
mongo-data/
docker/data/

# 5. Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Testing, Reports & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/
.vitest/

# 7. IDE & Editor Configurations
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# 8. OS-Specific Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# 9. Tool & Bundler Caches
.eslintcache
.stylelintcache
.oxlint-cache/
.turbo/
.parcel-cache/
.vite/
apps/*/.vite/
